{
  "name": "hoshi-desktop-pet",
  "version": "0.1.0",
  "description": "A Tamagotchi-style desktop pet featuring Darkness from Konosuba",
  "main": "dist/main/app.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:main": "tsc -p tsconfig.json --watch",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "start": "electron dist/main/app.js",
    "clean": "rm -rf dist/"
  },
  "keywords": [
    "tamagotchi",
    "desktop-pet",
    "electron",
    "typescript"
  ],
  "author": "EsTOEban",
  "license": "PolyForm-Strict-1.0.0",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^24.13.0",
    "eslint": "^9.6.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
